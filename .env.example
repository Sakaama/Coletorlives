# =============================================================================
# TUTUCO CLIP MINER — Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your environment.
# All fields below are placeholders; no default secrets are embedded.
# =============================================================================

# Server & Network Configuration
PORT=8765
ALLOW_REMOTE=false

# Session & Security
# When AUTH_REQUIRED=true, SECRET_KEY is mandatory and must be provided externally.
SECRET_KEY=
AUTH_REQUIRED=false

# Role-based User Passwords (PBKDF2/scrypt hashed at runtime)
# When AUTH_REQUIRED=true, ADMIN_PASSWORD is required to initialize administrative access.
ADMIN_PASSWORD=
EDITOR_PASSWORD=
VIEWER_PASSWORD=

# Radar Webhook Authentication
# Used to authenticate incoming alerts at POST /api/webhook/radar
# Provide via X-Radar-Secret header or Bearer token
RADAR_WEBHOOK_SECRET=

# Google Cloud Platform (Optional - enables Cloud Storage & Firestore sync)
# Leave blank for 100% offline local operation with SQLite and local storage
GOOGLE_CLOUD_PROJECT=
BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Telegram Integration (Optional - enables sending edited clips & publication packages)
# Leave blank to operate without Telegram publishing
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
